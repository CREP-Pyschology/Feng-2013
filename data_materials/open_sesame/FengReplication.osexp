	run Passage_2_Comprehension always

define loop Passage_2_Booklet_1
	set source_file ""
	set source table
	set repeat 1
	set order sequential
	set description "Repeatedly runs another item"
	set cycles 13
	set continuous no
	set break_if_on_first yes
