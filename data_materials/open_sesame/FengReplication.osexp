define sketchpad Passage
	set duration 0
	set description "Displays stimuli"
	draw textline center=0 color=black font_bold=no font_family=mono font_italic=no font_size=22 html=yes show_if=always text="[line_text]" x=-450 y=-200 z_index=0

define sequence Passage_1
	set flush_keyboard yes
	set description "Runs a number of items in sequence"
	run Passage_1_Booklet_1 "[booklet_assign] = 1"
	run Passage_1_Booklet_2 "[booklet_assign] = 2"
	run P1_Comprehension_Instructions always
	run Passage_1_Comprehension always

define loop Passage_1_Booklet_1
	set source_file ""
	set source table
	set repeat 1
	set order sequential
	set description "Repeatedly runs another item"
	set cycles 62
	set continuous no
	set break_if_on_first yes
	set break_if never
	setcycle 0 passage 1
	setcycle 0 line 0
	setcycle 0 line_text "Passage 1"
	setcycle 0 probe n
	setcycle 0 condition "Diff."
	setcycle 0 Condition_Num 1
	setcycle 0 comprehension_q n
	setcycle 0 booklet 1
	setcycle 1 passage 1
	setcycle 1 line 1
	setcycle 1 line_text "A few had been astute enough to see a fine poet in Browning, and <br/>Elizabeth Barrett was one of them. "
	setcycle 1 probe n
	setcycle 1 condition "Diff."
	setcycle 1 Condition_Num 1
	setcycle 1 comprehension_q n
	setcycle 1 booklet 1
	setcycle 2 passage 1
	setcycle 2 line 2
	setcycle 2 line_text "The young man with the lemon-colored gloves and long dark hair and <br/>high-strung, restless manner who had visited her in 1846 had been <br/>moved to write to her because she had praised his poetry."
	setcycle 2 probe y
	setcycle 2 condition "Diff."
	setcycle 2 Condition_Num 1
	setcycle 2 comprehension_q n
	setcycle 2 booklet 1
	setcycle 3 passage 1
	setcycle 3 line 3
	setcycle 3 line_text "She found the man even more to her liking than the verse, and it was <br/>not so very long-only the time between May, 1845 and September, 1846-<br/>before Robert Browning had stolen the poetess from the dour father <br/>who guarded her like a dragon (never wanting her to marry any man), <br/>and taken her with him to Italy and a new life."
	setcycle 3 probe y
	setcycle 3 condition "Diff."
	setcycle 3 Condition_Num 1
	setcycle 3 comprehension_q n
	setcycle 3 booklet 1
	setcycle 4 passage 1
	setcycle 4 line 4
	setcycle 4 line_text "One morning, soon after their nuptials, Elizabeth Browning thrust a <br/>manuscript into her husband’s pocket, and then scampered upstairs in <br/>a swift confusion to her room. "
	setcycle 4 probe n
	setcycle 4 condition "Diff."
	setcycle 4 Condition_Num 1
	setcycle 4 comprehension_q n
	setcycle 4 booklet 1
	setcycle 5 passage 1
	setcycle 5 line 5
	setcycle 5 line_text "Written during the time of their courtship and love missives, it was <br/>a sonnet sequence on their love. "
	setcycle 5 probe n
	setcycle 5 condition "Diff."
	setcycle 5 Condition_Num 1
	setcycle 5 comprehension_q n
	setcycle 5 booklet 1
	setcycle 6 passage 1
	setcycle 6 line 6
	setcycle 6 line_text "These poems were never intended by Mrs. Browning to be published, but<br/> her poet husband promptly declared that they must be. "
	setcycle 6 probe n
	setcycle 6 condition "Diff."
	setcycle 6 Condition_Num 1
	setcycle 6 comprehension_q n
	setcycle 6 booklet 1
	setcycle 7 passage 1
	setcycle 7 line 7
	setcycle 7 line_text "The Sonnets from the Portuguese was his suggested title—a title which<br/> might shroud the fact that they were personal. "
	setcycle 7 probe n
	setcycle 7 condition "Diff."
	setcycle 7 Condition_Num 1
	setcycle 7 comprehension_q n
	setcycle 7 booklet 1
	setcycle 8 passage 1
	setcycle 8 line 8
	setcycle 8 line_text "They were in his mind “the finest sonnets written in our language <br/>since Shakespeare’s.”"
	setcycle 8 probe n
	setcycle 8 condition "Diff."
	setcycle 8 Condition_Num 1
	setcycle 8 comprehension_q n
	setcycle 8 booklet 1
	setcycle 9 passage 1
	setcycle 9 line 9
	setcycle 9 line_text "Sonnets from the Portuguese, in Browning’s opinion, was hardly more <br/>flattering to his wife than his opinion of most of her poetry. "
	setcycle 9 probe n
	setcycle 9 condition "Diff."
	setcycle 9 Condition_Num 1
	setcycle 9 comprehension_q n
	setcycle 9 booklet 1
	setcycle 10 passage 1
	setcycle 10 line 10
	setcycle 10 line_text "A better poet than he, thought Browning, and the world at that time <br/>agreed with him."
	setcycle 10 probe n
	setcycle 10 condition "Diff."
	setcycle 10 Condition_Num 1
	setcycle 10 comprehension_q n
	setcycle 10 booklet 1
	setcycle 11 passage 1
	setcycle 11 line 11
	setcycle 11 line_text "He called her his “moon of poets,” as she considered him her sun."
	setcycle 11 probe n
	setcycle 11 condition "Diff."
	setcycle 11 Condition_Num 1
	setcycle 11 comprehension_q n
	setcycle 11 booklet 1
	setcycle 12 passage 1
	setcycle 12 line 12
	setcycle 12 line_text "She was a pure singer with a lovely lyrical tenderness, the best poet<br/> of her sex since Sappho. "
	setcycle 12 probe n
	setcycle 12 condition "Diff."
	setcycle 12 Condition_Num 1
	setcycle 12 comprehension_q n
	setcycle 12 booklet 1
	setcycle 13 passage 1
	setcycle 13 line 13
	setcycle 13 line_text "Her Sonnets, in their autobiographical candor, in their fine <br/>restraint and fullness, reveal a woman’s secret soul as had no other <br/>poetry in our literature up to that time. "
	setcycle 13 probe n
	setcycle 13 condition "Diff."
	setcycle 13 Condition_Num 1
	setcycle 13 comprehension_q n
	setcycle 13 booklet 1
	setcycle 14 passage 1
	setcycle 14 line 14
	setcycle 14 line_text "Her lyrical mastery shines in many passages of her writings."
	setcycle 14 probe n
	setcycle 14 condition "Diff."
	setcycle 14 Condition_Num 1
	setcycle 14 comprehension_q n
	setcycle 14 booklet 1
	setcycle 15 passage 1
	setcycle 15 line 15
	setcycle 15 line_text "Italy was a kind of promised terrain for Elizabeth Browning. "
	setcycle 15 probe n
	setcycle 15 condition "Diff."
	setcycle 15 Condition_Num 1
	setcycle 15 comprehension_q n
	setcycle 15 booklet 1
	setcycle 16 passage 1
	setcycle 16 line 16
	setcycle 16 line_text "Living in Florence or in little villages in the summers, she drank in<br/> the sun of the south and warmth of her husband’s love, and blossomed <br/>in a life of precarious happiness for fifteen years. "
	setcycle 16 probe n
	setcycle 16 condition "Diff."
	setcycle 16 Condition_Num 1
	setcycle 16 comprehension_q n
	setcycle 16 booklet 1
	setcycle 17 passage 1
	setcycle 17 line 17
	setcycle 17 line_text "In Italy she found friends, most of them cultured Americans."
	setcycle 17 probe n
	setcycle 17 condition "Diff."
	setcycle 17 Condition_Num 1
	setcycle 17 comprehension_q n
	setcycle 17 booklet 1
	setcycle 18 passage 1
	setcycle 18 line 18
	setcycle 18 line_text "Hawthorne saw the Browning's there: the New England thinker and <br/>essayist Margaret Fuller visited them."
	setcycle 18 probe y
	setcycle 18 condition "Diff."
	setcycle 18 Condition_Num 1
	setcycle 18 comprehension_q n
	setcycle 18 booklet 1
	setcycle 19 passage 1
	setcycle 19 line 19
	setcycle 19 line_text "The painter Story came, and the young sculptress Harriet Hosmer. "
	setcycle 19 probe n
	setcycle 19 condition "Diff."
	setcycle 19 Condition_Num 1
	setcycle 19 comprehension_q n
	setcycle 19 booklet 1
	setcycle 20 passage 1
	setcycle 20 line 20
	setcycle 20 line_text "One caller records that Robert Browning was 'simple, natural, and <br/>playful,' and that Mrs. Browning was all 'genius and sensibility.'"
	setcycle 20 probe y
	setcycle 20 condition "Diff."
	setcycle 20 Condition_Num 1
	setcycle 20 comprehension_q n
	setcycle 20 booklet 1
	setcycle 21 passage 1
	setcycle 21 line 21
	setcycle 21 line_text "Daytimes Browning walked forth with Elizabeth's little dog Flush, but<br/> he seldom could be lured from his home evenings. "
	setcycle 21 probe y
	setcycle 21 condition "Diff."
	setcycle 21 Condition_Num 1
	setcycle 21 comprehension_q n
	setcycle 21 booklet 1
	setcycle 22 passage 1
	setcycle 22 line 22
	setcycle 22 line_text "One privileged intruder, coming frequently at night to join the poets<br/> over hot chestnuts and mulled wine, found talk good and laughter plentiful."
	setcycle 22 probe y
	setcycle 22 condition "Diff."
	setcycle 22 Condition_Num 1
	setcycle 22 comprehension_q n
	setcycle 22 booklet 1
	setcycle 23 passage 1
	setcycle 23 line 23
	setcycle 23 line_text "During the third year of their stay in Italy, a son, Robert Weidemann<br/> Browning, was born."
	setcycle 23 probe n
	setcycle 23 condition "Diff."
	setcycle 23 Condition_Num 1
	setcycle 23 comprehension_q n
	setcycle 23 booklet 1
	setcycle 24 passage 1
	setcycle 24 line 24
	setcycle 24 line_text "But through this happy life a strain of dark foreboding began to <br/>creep. "
	setcycle 24 probe n
	setcycle 24 condition "Diff."
	setcycle 24 Condition_Num 1
	setcycle 24 comprehension_q n
	setcycle 24 booklet 1
	setcycle 25 passage 1
	setcycle 25 line 25
	setcycle 25 line_text "Elizabeth Browning’s father died unrelenting in his disavowal of her <br/>marriage, refusing to see her or to sanction any of his family to see her. "
	setcycle 25 probe n
	setcycle 25 condition "Diff."
	setcycle 25 Condition_Num 1
	setcycle 25 comprehension_q n
	setcycle 25 booklet 1
	setcycle 26 passage 1
	setcycle 26 line 26
	setcycle 26 line_text "Three children all younger than her own boy were left to her by a <br/>dearly beloved sister who died. "
	setcycle 26 probe n
	setcycle 26 condition "Diff."
	setcycle 26 Condition_Num 1
	setcycle 26 comprehension_q n
	setcycle 26 booklet 1
	setcycle 27 passage 1
	setcycle 27 line 27
	setcycle 27 line_text "She drooped and pined a little and Browning shielded her from <br/>ordinary visitants. "
	setcycle 27 probe n
	setcycle 27 condition "Diff."
	setcycle 27 Condition_Num 1
	setcycle 27 comprehension_q n
	setcycle 27 booklet 1
	setcycle 28 passage 1
	setcycle 28 line 28
	setcycle 28 line_text "She had a sudden and alarming attack of indisposition but was not <br/>considered in any precariousness. "
	setcycle 28 probe n
	setcycle 28 condition "Diff."
	setcycle 28 Condition_Num 1
	setcycle 28 comprehension_q n
	setcycle 28 booklet 1
	setcycle 29 passage 1
	setcycle 29 line 29
	setcycle 29 line_text "One night, soon after, she awoke from a troubled slumber and, <br/>apparently with no idea that she was about to leave him, murmured in <br/>the tenderest fashion of her love for him, and in his arms her head <br/>drooped as though in a faint, but it was the end."
	setcycle 29 probe n
	setcycle 29 condition "Diff."
	setcycle 29 Condition_Num 1
	setcycle 29 comprehension_q n
	setcycle 29 booklet 1
	setcycle 30 passage 1
	setcycle 30 line 30
	setcycle 30 line_text "Passage 1"
	setcycle 30 probe y
	setcycle 30 condition "Diff."
	setcycle 30 Condition_Num 1
	setcycle 30 comprehension_q n
	setcycle 30 booklet 1
	setcycle 31 passage ""
	setcycle 31 line ""
	setcycle 31 line_text "A few had been astute enough to see a fine poet in Browning, and <br/>Elizabeth Barrett was one of them. "
	setcycle 31 probe ""
	setcycle 31 condition ""
	setcycle 31 Condition_Num ""
	setcycle 31 comprehension_q ""
	setcycle 31 booklet ""
