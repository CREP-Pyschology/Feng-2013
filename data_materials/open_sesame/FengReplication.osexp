	setcycle 2 Condition_Num ""
	setcycle 2 comprehension_q y
	setcycle 2 booklet ""
	setcycle 2 correct_response e
	setcycle 3 passage 1
	setcycle 3 line 4
	setcycle 3 line_text "4.     Browning wrote to Miss Barrett because <br/>       she had<br/><br/>a.     invited him to visit<br/>b.     written him for advice<br/>c.     praised his poetry<br/>d.     sent him one of her own poems<br/>e.     sent a friend to meet him"
	setcycle 3 probe n
