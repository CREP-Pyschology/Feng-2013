define loop Passage_5_Booklet_1
	set source_file ""
	set source table
	set repeat 1
	set order sequential
	set description "Repeatedly runs another item"
	set cycles 10
	set continuous no
	set break_if_on_first yes
	set break_if never
	setcycle 0 passage 5
	setcycle 0 line 0
	setcycle 0 line_text "Passage 5"
	setcycle 0 probe n
	setcycle 0 condition "Diff."
	setcycle 0 Condition_Num 1
	setcycle 0 comprehension_q n
	setcycle 0 booklet 1
	setcycle 1 passage 5
	setcycle 1 line 1
	setcycle 1 line_text "The flavor, odor, and character so highly prized by the gourmet is <br/>given to cheese by fungi. "
	setcycle 1 probe n
	setcycle 1 condition "Diff."
	setcycle 1 Condition_Num 1
	setcycle 1 comprehension_q n
	setcycle 1 booklet 1
	setcycle 2 passage 5
	setcycle 2 line 2
	setcycle 2 line_text "In caves near the French village of Roquefort was first found one <br/>such mold. A peasant boy left his lunch, a mild fresh piece of goat <br/>cheese, according to legend, in one of these caverns and on returning <br/>found it marbled, tart, and redolent."
	setcycle 2 probe n
	setcycle 2 condition "Diff."
	setcycle 2 Condition_Num 1
	setcycle 2 comprehension_q n
	setcycle 2 booklet 1
	setcycle 3 passage 5
	setcycle 3 line 3
	setcycle 3 line_text "Only cheeses from the area around these particular caves are <br/>permitted to bear the name of Roquefort."
	setcycle 3 probe n
	setcycle 3 condition "Diff."
	setcycle 3 Condition_Num 1
	setcycle 3 comprehension_q n
	setcycle 3 booklet 1
	setcycle 4 passage 5
	setcycle 4 line 4
	setcycle 4 line_text "As early as the seventeenth century, ergot, the fungus of rye, was <br/>used to facilitate childbirth."
	setcycle 4 probe y
	setcycle 4 condition "Diff."
	setcycle 4 Condition_Num 1
	setcycle 4 comprehension_q n
	setcycle 4 booklet 1
	setcycle 5 passage 5
	setcycle 5 line 5
	setcycle 5 line_text "The contraction of the involuntary muscles, particularly of the <br/>uterus, is one of its effects. "
	setcycle 5 probe n
	setcycle 5 condition "Diff."
	setcycle 5 Condition_Num 1
	setcycle 5 comprehension_q n
	setcycle 5 booklet 1
	setcycle 6 passage 5
	setcycle 6 line 6
	setcycle 6 line_text "In the twentieth century, ergot has once more attracted interest as <br/>the source of the chemical from which the hallucinogenic drug LSD is <br/>derived. "
	setcycle 6 probe y
	setcycle 6 condition "Diff."
	setcycle 6 Condition_Num 1
	setcycle 6 comprehension_q n
	setcycle 6 booklet 1
	setcycle 7 passage 5
	setcycle 7 line 7
	setcycle 7 line_text "Most of the modern antibiotics are produced by fungi."
	setcycle 7 probe n
	setcycle 7 condition "Diff."
	setcycle 7 Condition_Num 1
	setcycle 7 comprehension_q n
	setcycle 7 booklet 1
	setcycle 8 passage 5
	setcycle 8 line 8
	setcycle 8 line_text "The first of these was discovered by Alexander Fleming, who noted <br/>that a mold of the genus Penicillium which had contaminated a culture <br/>of staphylococcus growing on a nutrient agar plate had completely <br/>halted the proliferation of the bacteria."
	setcycle 8 probe n
	setcycle 8 condition "Diff."
	setcycle 8 Condition_Num 1
	setcycle 8 comprehension_q n
	setcycle 8 booklet 1
	setcycle 9 passage 5
	setcycle 9 line 9
	setcycle 9 line_text "Antibiotics, of which many hundreds have now been discovered, are <br/>substances produced by a living organism that injure another living <br/>organism."
	setcycle 9 probe y
	setcycle 9 condition "Diff."
	setcycle 9 Condition_Num 1
	setcycle 9 comprehension_q n
	setcycle 9 booklet 1
	run Passage_sequence

