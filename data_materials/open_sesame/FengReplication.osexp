define loop Passage_4_Booklet_1
	set source_file ""
	set source table
	set repeat 1
	set order sequential
	set description "Repeatedly runs another item"
	set cycles 14
	set continuous no
	set break_if_on_first yes
	set break_if never
	setcycle 0 passage 4
	setcycle 0 line 0
	setcycle 0 line_text "Passage 4"
	setcycle 0 probe n
	setcycle 0 condition Easy
	setcycle 0 Condition_Num 2
	setcycle 0 comprehension_q n
	setcycle 0 booklet 1
	setcycle 1 passage 4
	setcycle 1 line 1
	setcycle 1 line_text "The possibility of life on Mars is not dismissed even by skeptics."
	setcycle 1 probe n
	setcycle 1 condition Easy
	setcycle 1 Condition_Num 2
	setcycle 1 comprehension_q n
	setcycle 1 booklet 1
	setcycle 2 passage 4
	setcycle 2 line 2
	setcycle 2 line_text "They seem to share our hope that it is true."
	setcycle 2 probe n
	setcycle 2 condition Easy
	setcycle 2 Condition_Num 2
	setcycle 2 comprehension_q n
	setcycle 2 booklet 1
	setcycle 3 passage 4
	setcycle 3 line 3
	setcycle 3 line_text "So, it was disappointing when scientists studied photos from the <br/>early Mariner space flights in the mid-1960's."
	setcycle 3 probe n
	setcycle 3 condition Easy
	setcycle 3 Condition_Num 2
	setcycle 3 comprehension_q n
	setcycle 3 booklet 1
	setcycle 4 passage 4
	setcycle 4 line 4
	setcycle 4 line_text "They saw no canals, no seas, and no busy Martian engineers."
	setcycle 4 probe n
	setcycle 4 condition Easy
	setcycle 4 Condition_Num 2
	setcycle 4 comprehension_q n
	setcycle 4 booklet 1
	setcycle 5 passage 4
	setcycle 5 line 5
	setcycle 5 line_text "They saw no dangerous, warlike Martians as huge as skyscrapers."
	setcycle 5 probe n
	setcycle 5 condition Easy
	setcycle 5 Condition_Num 2
	setcycle 5 comprehension_q n
	setcycle 5 booklet 1
	setcycle 6 passage 4
	setcycle 6 line 6
	setcycle 6 line_text "All they saw were mountains, craters, cold winds, and dust storms."
	setcycle 6 probe n
	setcycle 6 condition Easy
	setcycle 6 Condition_Num 2
	setcycle 6 comprehension_q n
	setcycle 6 booklet 1
	setcycle 7 passage 4
	setcycle 7 line 7
	setcycle 7 line_text "It was almost as if scouts for Columbus had returned to Isabella’s <br/>court with the news that the world had turned out to be flat after <br/>all."
	setcycle 7 probe y
	setcycle 7 condition Easy
	setcycle 7 Condition_Num 2
	setcycle 7 comprehension_q n
	setcycle 7 booklet 1
	setcycle 8 passage 4
	setcycle 8 line 8
	setcycle 8 line_text "Hopeful astronomers reminded us that the Mariner IV had photographed <br/>a mere one percent of the Martian surface from 2,000 miles away."
	setcycle 8 probe y
	setcycle 8 condition Easy
	setcycle 8 Condition_Num 2
	setcycle 8 comprehension_q n
	setcycle 8 booklet 1
	setcycle 9 passage 4
	setcycle 9 line 9
	setcycle 9 line_text "In addition, the photos were taken from 2,000 miles away."
	setcycle 9 probe n
	setcycle 9 condition Easy
	setcycle 9 Condition_Num 2
	setcycle 9 comprehension_q n
	setcycle 9 booklet 1
	setcycle 10 passage 4
	setcycle 10 line 10
	setcycle 10 line_text "And they pointed out that the Earth-orbiting Tiros weather satellite <br/>shot over 20,000 pictures before uncovering any evidence of life on <br/>Earth."
	setcycle 10 probe y
	setcycle 10 condition Easy
	setcycle 10 Condition_Num 2
	setcycle 10 comprehension_q n
	setcycle 10 booklet 1
	setcycle 11 passage 4
	setcycle 11 line 11
	setcycle 11 line_text "But still, public enthusiasm for Martian exploration wilted."
	setcycle 11 probe y
	setcycle 11 condition Easy
	setcycle 11 Condition_Num 2
	setcycle 11 comprehension_q n
	setcycle 11 booklet 1
	setcycle 12 passage 4
	setcycle 12 line 12
	setcycle 12 line_text "Few people seemed to care about life on Mars by the time Viking I <br/>landed on the Plain of Chrise in August."
	setcycle 12 probe n
	setcycle 12 condition Easy
	setcycle 12 Condition_Num 2
	setcycle 12 comprehension_q n
	setcycle 12 booklet 1
	setcycle 13 passage 4
	setcycle 13 line 13
	setcycle 13 line_text "One Viking scientist, J. Richard Keefe, said that he was “disgusted” <br/>at the “blasé...apathetic” public response and the skimpy television <br/>coverage of one of the most magnificent scientific and technical <br/>accomplishments in human history."
	setcycle 13 probe n
	setcycle 13 condition Easy
	setcycle 13 Condition_Num 2
	setcycle 13 comprehension_q n
	setcycle 13 booklet 1
	run Passage_sequence

define loop Passage_4_Booklet_2
	set source_file ""
	set source table
	set repeat 1
	set order sequential
