	setcycle 41 comprehension_q ""
	setcycle 41 booklet ""
	setcycle 42 passage ""
	setcycle 42 line ""
	setcycle 42 line_text "She was a pure singer with a lovely lyrical tenderness, the best poet<br/>of her sex since Sappho. "
