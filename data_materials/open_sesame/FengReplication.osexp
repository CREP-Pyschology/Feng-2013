	setcycle 0 comprehension_q y
	setcycle 0 booklet ""
	setcycle 0 correct_response b
	setcycle 1 passage 1
	setcycle 1 line 2
	setcycle 1 line_text "2.     At night the Brownings often enjoyed<br/><br/>a.     hot chestnuts<br/>b.     a tart with clotted cream<br/>c.     strawberries and cream<br/>d.     café au lait<br/>e.     cheese soufflé"
