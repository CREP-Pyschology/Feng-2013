	setcycle 18 congruity ""
	run Trial_sequence

define sketchpad Target1500
	set reset_variables no
	set duration 0
	set description "Displays stimuli"
	draw textline center=1 color="[color]" font_bold=no font_family=mono font_italic=no font_size=65 html=yes show_if=always text="[word]" x=0 y=0 z_index=0

define sequence Trial_sequence
	set flush_keyboard yes
	set description "Runs a number of items in sequence"
	run Blank1000 always
	run Fixation200 always
	run Blank200 always
	run Target1500 always
	run keyboard_response always
	run logger always

define sketchpad _sketchpad
	set reset_variables no
	set duration keypress
	set description "Displays stimuli"

define sequence experiment
	set flush_keyboard yes
	set description "Runs a number of items in sequence"
	run welcome always
	run Main_practice_loop always
	run Main_experiment_loop always
	run Goodbye always

define feedback feedback
	set reset_variables yes
	set duration keypress
	set description "Provides feedback to the participant"
	draw textline center=1 color=white font_bold=no font_family=mono font_italic=no font_size=32 html=yes show_if=always text="Your average response time was [avg_rt]ms" x=0 y=-96 z_index=0
	draw textline center=1 color=white font_bold=no font_family=mono font_italic=no font_size=32 html=yes show_if=always text="Your accuracy was [acc]%" x=0 y=-32 z_index=0
	draw textline center=1 color=white font_bold=no font_family=mono font_italic=no font_size=32 html=yes show_if=always text="Press any key to continue" x=0 y=32 z_index=0

define keyboard_response keyboard_response
	set timeout infinite
	set flush yes
	set event_type keypress
	set duration keypress
	set description "Collects keyboard responses"
	set allowed_responses "v;b;n"

define logger logger
	set description "Logs experimental data"
	set auto_log yes

define reset_feedback reset_feedback
	set description "Resets the feedback variables, such as 'avg_rt' and 'acc'"

define sketchpad welcome
	set start_response_interval no
	set reset_variables no
	set duration keypress
	set description "Displays stimuli"
	draw textline center=1 color=white font_bold=no font_family=serif font_italic=no font_size=27 html=yes show_if=always text="Welcome to the experiment!<br /><br />Because of the importance of concentration<br />to the result of this study,<br /><br />we would like to ask you to turn off<br />you phone completely" x=0 y=-224 z_index=0
	draw textline center=1 color=white font_bold=no font_family=serif font_italic=no font_size=27 html=yes show_if=always text="Please let the experimenter know if:<br /><br />1. You use glasses/contact lenses and they are not here with you<br /><br />2. You take any medication that can affect your alertness<br /><br />3. For some reason you don't feel alert<br /><br />4. You were previously diagnosed with <br />attention deficits and learning disabilities" x=0 y=128 z_index=0

