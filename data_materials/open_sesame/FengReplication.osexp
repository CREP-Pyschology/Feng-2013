	setcycle 3 Condition_Num ""
	setcycle 3 comprehension_q y
	setcycle 3 booklet ""
	setcycle 3 correct_response c
	setcycle 4 passage 1
	setcycle 4 line 5
	setcycle 4 line_text "5.     The authors of this passage placed most <br/>       attention on the Brownings’<br/><br/>a.     literary efforts<br/>b.     personal relationship<br/>c.     social contacts<br/>d.     problems<br/>e.     early meeting"
	setcycle 4 probe n
	setcycle 4 condition ""
	setcycle 4 Condition_Num ""
	setcycle 4 comprehension_q y
	setcycle 4 booklet ""
	setcycle 4 correct_response b
	setcycle 5 passage 1
	setcycle 5 line 6
