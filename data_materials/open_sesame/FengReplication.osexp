define loop Passage_6_Booklet_1
	set source_file ""
	set source table
	set repeat 1
	set order sequential
	set description "Repeatedly runs another item"
	set cycles 16
	set continuous no
	set break_if_on_first yes
	set break_if never
	setcycle 0 passage 6
	setcycle 0 line 0
	setcycle 0 line_text "Passage 6"
	setcycle 0 probe n
	setcycle 0 condition Easy
	setcycle 0 Condition_Num 2
	setcycle 0 comprehension_q n
	setcycle 0 booklet 1
	setcycle 1 passage 6
	setcycle 1 line 1
	setcycle 1 line_text "Local governments were our first governments."
	setcycle 1 probe y
	setcycle 1 condition Easy
	setcycle 1 Condition_Num 2
	setcycle 1 comprehension_q n
	setcycle 1 booklet 1
	setcycle 2 passage 6
	setcycle 2 line 2
	setcycle 2 line_text "A local government was established when the oldest men in a <br/>primitive tribe formed a council and the tribe chose a chief."
	setcycle 2 probe n
	setcycle 2 condition Easy
	setcycle 2 Condition_Num 2
	setcycle 2 comprehension_q n
	setcycle 2 booklet 1
	setcycle 3 passage 6
	setcycle 3 line 3
	setcycle 3 line_text "The tribe was seeking a better, safer life."
	setcycle 3 probe n
	setcycle 3 condition Easy
	setcycle 3 Condition_Num 2
	setcycle 3 comprehension_q n
	setcycle 3 booklet 1
	setcycle 4 passage 6
	setcycle 4 line 4
	setcycle 4 line_text "In the same way, the first English settlers soon realized that they <br/>needed rules and leaders after they landed at Jamestown, Virginia in <br/>1607. "
	setcycle 4 probe n
	setcycle 4 condition Easy
	setcycle 4 Condition_Num 2
	setcycle 4 comprehension_q n
	setcycle 4 booklet 1
	setcycle 5 passage 6
	setcycle 5 line 5
	setcycle 5 line_text "At first, the settlers had to look out for themselves. "
	setcycle 5 probe n
	setcycle 5 condition Easy
	setcycle 5 Condition_Num 2
	setcycle 5 comprehension_q n
	setcycle 5 booklet 1
	setcycle 6 passage 6
	setcycle 6 line 6
	setcycle 6 line_text "They searched for gold, and had to find their own food and provide <br/>their own shelter."
	setcycle 6 probe n
	setcycle 6 condition Easy
	setcycle 6 Condition_Num 2
	setcycle 6 comprehension_q n
	setcycle 6 booklet 1
	setcycle 7 passage 6
	setcycle 7 line 7
	setcycle 7 line_text "As food supplies began to run low, and as the colonists faced hunger <br/>and disease, they saw that they needed to work together if the <br/>colony was to survive."
	setcycle 7 probe y
	setcycle 7 condition Easy
	setcycle 7 Condition_Num 2
	setcycle 7 comprehension_q n
	setcycle 7 booklet 1
	setcycle 8 passage 6
	setcycle 8 line 8
	setcycle 8 line_text "So, they needed to work together if the colony was to survive."
	setcycle 8 probe n
	setcycle 8 condition Easy
	setcycle 8 Condition_Num 2
	setcycle 8 comprehension_q n
	setcycle 8 booklet 1
	setcycle 9 passage 6
	setcycle 9 line 9
	setcycle 9 line_text "The colonists formed a council to make laws for the colony."
	setcycle 9 probe n
	setcycle 9 condition Easy
	setcycle 9 Condition_Num 2
	setcycle 9 comprehension_q n
	setcycle 9 booklet 1
	setcycle 10 passage 6
	setcycle 10 line 10
	setcycle 10 line_text "They chose Captain John Smith as president of the council. "
	setcycle 10 probe n
	setcycle 10 condition Easy
	setcycle 10 Condition_Num 2
	setcycle 10 comprehension_q n
	setcycle 10 booklet 1
	setcycle 11 passage 6
	setcycle 11 line 11
	setcycle 11 line_text "His job was to see that the laws were carried out. "
	setcycle 11 probe n
	setcycle 11 condition Easy
	setcycle 11 Condition_Num 2
	setcycle 11 comprehension_q n
	setcycle 11 booklet 1
	setcycle 12 passage 6
	setcycle 12 line 12
	setcycle 12 line_text "This government at Jamestown was the first local government in <br/>America."
	setcycle 12 probe y
	setcycle 12 condition Easy
	setcycle 12 Condition_Num 2
	setcycle 12 comprehension_q n
	setcycle 12 booklet 1
	setcycle 13 passage 6
	setcycle 13 line 13
	setcycle 13 line_text "Today, local government is still the first and most important one in <br/>our lives. "
	setcycle 13 probe n
	setcycle 13 condition Easy
	setcycle 13 Condition_Num 2
	setcycle 13 comprehension_q n
	setcycle 13 booklet 1
	setcycle 14 passage 6
	setcycle 14 line 14
	setcycle 14 line_text "It protects our lives, our safety, and our homes, and it helps to <br/>keep our environment clean."
	setcycle 14 probe y
	setcycle 14 condition Easy
	setcycle 14 Condition_Num 2
	setcycle 14 comprehension_q n
	setcycle 14 booklet 1
	setcycle 15 passage 6
	setcycle 15 line 15
	setcycle 15 line_text "Local government provides us with schools, libraries, and other <br/>important services."
	setcycle 15 probe n
	setcycle 15 condition Easy
	setcycle 15 Condition_Num 2
	setcycle 15 comprehension_q n
	setcycle 15 booklet 1
	run Passage_sequence

