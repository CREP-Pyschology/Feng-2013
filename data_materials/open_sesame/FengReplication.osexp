	setcycle 44 comprehension_q ""
	setcycle 44 booklet ""
	setcycle 45 passage ""
	setcycle 45 line ""
	setcycle 45 line_text "Italy was a kind of promised terrain for Elizabeth Browning. "
	setcycle 45 probe ""
	setcycle 45 condition ""
	setcycle 45 Condition_Num ""
	setcycle 45 comprehension_q ""
	setcycle 45 booklet ""
	setcycle 46 passage ""
	setcycle 46 line ""
	setcycle 46 line_text "Living in Florence or in little villages in the summers, she drank in<br/>the sun of the south and warmth of her husband’s love, and blossomed <br/>in a life of precarious happiness for fifteen years. "
	setcycle 46 probe ""
	setcycle 46 condition ""
	setcycle 46 Condition_Num ""
