define loop Passage_7_Comprehension
	set source_file ""
	set source table
	set repeat 1
	set order sequential
	set description "Repeatedly runs another item"
	set cycles 4
	set continuous no
	set break_if_on_first yes
	set break_if never
	setcycle 0 passage 7
	setcycle 0 line 1
	setcycle 0 line_text "1.     In his paintings, Caravaggio included<br/><br/>a.     common people<br/>b.     strange landscapes<br/>c.     eerie, silvery buildings<br/>d.     ghosts<br/>e.     corpses"
	setcycle 0 probe ""
	setcycle 0 condition ""
	setcycle 0 Condition_Num ""
	setcycle 0 comprehension_q y
	setcycle 0 booklet ""
	setcycle 0 correct_response a
	setcycle 1 passage 7
	setcycle 1 line 2
	setcycle 1 line_text "2.     El Greco pursued his early career in <br/><br/>a.     Italy<br/>b.     Greece<br/>c.     Lombardy<br/>d.     Rome<br/>e.     Toledo"
	setcycle 1 probe ""
	setcycle 1 condition ""
	setcycle 1 Condition_Num ""
	setcycle 1 comprehension_q y
	setcycle 1 booklet ""
	setcycle 1 correct_response a
	setcycle 2 passage 7
	setcycle 2 line 3
	setcycle 2 line_text "3.     Apparently a major technique of <br/>       Caravaggio’s was<br/><br/>a.     using exalted religious subjects<br/>b.     using stark contrasts<br/>c.     using cadavers<br/>d.     using ghostlike stillness<br/>e.     none of the above"
	setcycle 2 probe ""
	setcycle 2 condition ""
	setcycle 2 Condition_Num ""
	setcycle 2 comprehension_q y
	setcycle 2 booklet ""
	setcycle 2 correct_response b
	setcycle 3 passage 7
	setcycle 3 line 4
	setcycle 3 line_text "4.     The principal idea discussed in this <br/>       passage concerns<br/><br/>a.     El Greco<br/>b.     Caravaggio<br/>c.     Contemporary approval of artists<br/>d.     The travels of painters<br/>e.     The prosperity of artists"
	setcycle 3 probe ""
	setcycle 3 condition ""
	setcycle 3 Condition_Num ""
	setcycle 3 comprehension_q y
	setcycle 3 booklet ""
	setcycle 3 correct_response c
	run Passage_Comprehension

define sequence Passage_8
	set flush_keyboard yes
	set description "Runs a number of items in sequence"
	run Passage_8_Booklet_1 "[booklet_assign] = 1"
	run Passage_8_Booklet_2 "[booklet_assign] = 2"
	run P8_Comprehension_Instructions always
	run Passage_8_Comprehension always

define loop Passage_8_Booklet_1
	set source_file ""
	set source table
	set repeat 1
	set order sequential
	set description "Repeatedly runs another item"
	set cycles 12
	set continuous no
	set break_if_on_first yes
	set break_if never
	setcycle 0 passage 8
	setcycle 0 line 0
	setcycle 0 line_text "Passage 8"
	setcycle 0 probe n
	setcycle 0 condition Easy
	setcycle 0 Condition_Num 2
	setcycle 0 comprehension_q n
	setcycle 0 booklet 1
	setcycle 1 passage 8
	setcycle 1 line 1
	setcycle 1 line_text "Random assignment is the key to experimental design."
	setcycle 1 probe n
	setcycle 1 condition Easy
	setcycle 1 Condition_Num 2
	setcycle 1 comprehension_q n
	setcycle 1 booklet 1
	setcycle 2 passage 8
	setcycle 2 line 2
	setcycle 2 line_text "Random assignment insures that the results of experiments are not <br/>influenced by some extraneous variable."
	setcycle 2 probe n
	setcycle 2 condition Easy
	setcycle 2 Condition_Num 2
	setcycle 2 comprehension_q n
	setcycle 2 booklet 1
	setcycle 3 passage 8
	setcycle 3 line 3
	setcycle 3 line_text "An extraneous variable is one that is correlated with the variable <br/>under investigation."
	setcycle 3 probe n
	setcycle 3 condition Easy
	setcycle 3 Condition_Num 2
	setcycle 3 comprehension_q n
	setcycle 3 booklet 1
	setcycle 4 passage 8
	setcycle 4 line 4
	setcycle 4 line_text "In contrast, correlational designs allow subjects to assign <br/>themselves to conditions."
	setcycle 4 probe n
	setcycle 4 condition Easy
	setcycle 4 Condition_Num 2
	setcycle 4 comprehension_q n
	setcycle 4 booklet 1
	setcycle 5 passage 8
	setcycle 5 line 5
	setcycle 5 line_text "Thus, in the cancer studies as they have been done, only people who <br/>are four-pack-a-day smokers—by their own “choice”—get into a four-<br/>pack-a-day condition."
	setcycle 5 probe y
	setcycle 5 condition Easy
	setcycle 5 Condition_Num 2
	setcycle 5 comprehension_q n
	setcycle 5 booklet 1
	setcycle 6 passage 8
	setcycle 6 line 6
	setcycle 6 line_text "But, the factors that make people four-pack-a-day smokers must surely <br/>make them different from typical nonsmokers in other ways.  "
	setcycle 6 probe n
	setcycle 6 condition Easy
	setcycle 6 Condition_Num 2
	setcycle 6 comprehension_q n
	setcycle 6 booklet 1
	setcycle 7 passage 8
	setcycle 7 line 7
	setcycle 7 line_text "Hence the ambiguity of interpretation in correlational designs, and <br/>hence the virtue of experimental designs."
	setcycle 7 probe y
	setcycle 7 condition Easy
	setcycle 7 Condition_Num 2
	setcycle 7 comprehension_q n
	setcycle 7 booklet 1
	setcycle 8 passage 8
	setcycle 8 line 8
	setcycle 8 line_text "Differences among individual subjects cannot systematically confound <br/>the results if assignment to conditions is truly random."
	setcycle 8 probe n
	setcycle 8 condition Easy
	setcycle 8 Condition_Num 2
	setcycle 8 comprehension_q n
	setcycle 8 booklet 1
	setcycle 9 passage 8
	setcycle 9 line 9
	setcycle 9 line_text "Put another way, the experimenter has under his control all the <br/>variables that can influence the results."
	setcycle 9 probe y
	setcycle 9 condition Easy
	setcycle 9 Condition_Num 2
	setcycle 9 comprehension_q n
	setcycle 9 booklet 1
	setcycle 10 passage 8
	setcycle 10 line 10
	setcycle 10 line_text "It is another question as to whether they can exactly identify these <br/>variables. "
	setcycle 10 probe n
	setcycle 10 condition Easy
	setcycle 10 Condition_Num 2
	setcycle 10 comprehension_q n
	setcycle 10 booklet 1
	setcycle 11 passage 8
	setcycle 11 line 11
	setcycle 11 line_text "Thus, the results from experimental designs are not entirely <br/>unambiguous, but they are less ambiguous than the results from <br/>correlational designs."
	setcycle 11 probe n
	setcycle 11 condition Easy
	setcycle 11 Condition_Num 2
	setcycle 11 comprehension_q n
	setcycle 11 booklet 1
	run Passage_sequence

define loop Passage_8_Booklet_2
	set source_file ""
	set source table
	set repeat 1
	set order sequential
	set description "Repeatedly runs another item"
	set cycles 11
	set continuous no
	set break_if_on_first yes
	set break_if never
	setcycle 0 passage 8
	setcycle 0 line 0
	setcycle 0 line_text "Passage 8"
	setcycle 0 probe n
	setcycle 0 condition "Diff."
	setcycle 0 Condition_Num 1
	setcycle 0 comprehension_q n
	setcycle 0 booklet 2
	setcycle 1 passage 8
	setcycle 1 line 1
	setcycle 1 line_text "The key to the design called experimental is assignment of subjects <br/>to conditions randomly. "
	setcycle 1 probe n
	setcycle 1 condition "Diff."
	setcycle 1 Condition_Num 1
	setcycle 1 comprehension_q n
	setcycle 1 booklet 2
	setcycle 2 passage 8
	setcycle 2 line 2
	setcycle 2 line_text "By the influence on the results of some extraneous variable that is <br/>tied to or correlated with the variable under investigation is <br/>insured against."
	setcycle 2 probe n
	setcycle 2 condition "Diff."
	setcycle 2 Condition_Num 1
	setcycle 2 comprehension_q n
	setcycle 2 booklet 2
	setcycle 3 passage 8
	setcycle 3 line 3
	setcycle 3 line_text "By contrast with experimental designs, subjects, in correlational <br/>designs, in a sense, assign themselves to conditions."
	setcycle 3 probe n
	setcycle 3 condition "Diff."
	setcycle 3 Condition_Num 1
	setcycle 3 comprehension_q n
	setcycle 3 booklet 2
	setcycle 4 passage 8
	setcycle 4 line 4
	setcycle 4 line_text "Thus, in the cancer studies as they have been done, only people who <br/>are four-pack-a-day smokers—by their own “choice”—get into a four-<br/>pack-a-day condition."
	setcycle 4 probe y
	setcycle 4 condition "Diff."
	setcycle 4 Condition_Num 1
	setcycle 4 comprehension_q n
	setcycle 4 booklet 2
	setcycle 5 passage 8
	setcycle 5 line 5
	setcycle 5 line_text "Whatever the factors are that contribute to a person's being a heavy <br/>smoker surely must also make him different from the typical nonsmoker <br/>in other ways."
	setcycle 5 probe n
	setcycle 5 condition "Diff."
	setcycle 5 Condition_Num 1
	setcycle 5 comprehension_q n
	setcycle 5 booklet 2
	setcycle 6 passage 8
	setcycle 6 line 6
	setcycle 6 line_text "Hence the ambiguity of interpretation in correlational designs, and <br/>hence the virtue of experimental designs."
	setcycle 6 probe y
	setcycle 6 condition "Diff."
	setcycle 6 Condition_Num 1
	setcycle 6 comprehension_q n
	setcycle 6 booklet 2
	setcycle 7 passage 8
	setcycle 7 line 7
	setcycle 7 line_text "In the latter case, if assignment to conditions is truly random then <br/>prevailing differences among individual subjects cannot confound the <br/>results systematically."
	setcycle 7 probe n
	setcycle 7 condition "Diff."
	setcycle 7 Condition_Num 1
	setcycle 7 comprehension_q n
	setcycle 7 booklet 2
	setcycle 8 passage 8
	setcycle 8 line 8
	setcycle 8 line_text "Put another way, the experimenter has under his control all the <br/>variables that can influence the results."
	setcycle 8 probe y
	setcycle 8 condition "Diff."
	setcycle 8 Condition_Num 1
	setcycle 8 comprehension_q n
	setcycle 8 booklet 2
	setcycle 9 passage 8
	setcycle 9 line 9
	setcycle 9 line_text "Whether he can exactly identify these variables is another question. "
	setcycle 9 probe n
	setcycle 9 condition "Diff."
	setcycle 9 Condition_Num 1
	setcycle 9 comprehension_q n
	setcycle 9 booklet 2
	setcycle 10 passage 8
	setcycle 10 line 10
	setcycle 10 line_text "Thus, entirely unambiguous results are not yielded by experimental <br/>designs, merely results that are less ambiguous than those associated <br/>with correlational designs."
	setcycle 10 probe n
	setcycle 10 condition "Diff."
	setcycle 10 Condition_Num 1
	setcycle 10 comprehension_q n
	setcycle 10 booklet 2
	run Passage_sequence

define loop Passage_8_Comprehension
	set source_file ""
	set source table
	set repeat 1
	set order sequential
	set description "Repeatedly runs another item"
	set cycles 4
	set continuous no
	set break_if_on_first yes
	set break_if never
	setcycle 0 passage 8
	setcycle 0 line 1
	setcycle 0 line_text "1.     Specific mention is made of <br/><br/>a.     psychogenesis<br/>b.     psychodynamics<br/>c.     psychobiology<br/>d.     psychotherapy<br/>e.     none of the above"
	setcycle 0 probe ""
	setcycle 0 condition ""
	setcycle 0 Condition_Num ""
	setcycle 0 comprehension_q y
	setcycle 0 booklet ""
	setcycle 0 correct_response e
	setcycle 1 passage 8
	setcycle 1 line 2
	setcycle 1 line_text "2.     How many research design patterns were <br/>       discussed?<br/><br/>a.     One only<br/>b.     Two<br/>c.     Three<br/>d.     Four<br/>e.     Five"
	setcycle 1 probe ""
	setcycle 1 condition ""
	setcycle 1 Condition_Num ""
	setcycle 1 comprehension_q y
	setcycle 1 booklet ""
	setcycle 1 correct_response b
	setcycle 2 passage 8
	setcycle 2 line 3
	setcycle 2 line_text "3.     As used in this passage, the phrase put <br/>       another way means<br/><br/>a.     rephrasing<br/>b.     enumeration<br/>c.     using details<br/>d.     reasoning<br/>e.     illustration"
	setcycle 2 probe ""
	setcycle 2 condition ""
	setcycle 2 Condition_Num ""
	setcycle 2 comprehension_q y
	setcycle 2 booklet ""
	setcycle 2 correct_response a
	setcycle 3 passage 8
	setcycle 3 line 4
	setcycle 3 line_text "4.     In this passage the authors imply that <br/>       heavy smoking is probably caused by<br/><br/>a.     tension<br/>b.     nervousness<br/>c.     habit<br/>d.     social pressure<br/>e.     all the above and more"
	setcycle 3 probe ""
	setcycle 3 condition ""
	setcycle 3 Condition_Num ""
	setcycle 3 comprehension_q y
	setcycle 3 booklet ""
	setcycle 3 correct_response e
	run Passage_Comprehension

define sequence Passage_Comprehension
	set flush_keyboard yes
	set description "Runs a number of items in sequence"
	run Comprehension always
	run comprehension_response always
	run logger always

define sequence Passage_sequence
	set flush_keyboard yes
	set description "Runs a number of items in sequence"
	run Passage always
	run passage_response always
	run logger always
	run Probe "[probe] = y"
	run probe_response "[probe] = y"
	run logger "[probe] = y"

define sketchpad Probe
	set duration 0
	set description "Displays stimuli"
	draw textline center=0 color=black font_bold=no font_family=mono font_italic=no font_size=22 html=yes show_if="[booklet_assign] = [booklet] and [probe] = y" text="Were you mind wandering when you read the previous sentence?  YES  NO" x=-450 y=-200 z_index=0

define keyboard_response comprehension_response
	set timeout infinite
	set flush yes
	set duration keypress
	set description "Collects keyboard responses"
	set allowed_responses "a;b;c;d;e"

define sequence experiment
	set flush_keyboard yes
	set description "Runs a number of items in sequence"
	run Booklet_Assignment always
	run Passage_1 always
	run Passage_2 always
	run Passage_3 always
	run Passage_4 always
	run Passage_5 always
	run Passage_6 always
	run Passage_7 always
	run Passage_8 always
	run End_of_Experiment always

define logger logger
	set description "Logs experimental data"
	set auto_log yes

define keyboard_response passage_response
	set timeout infinite
	set flush yes
	set duration keypress
	set description "Collects keyboard responses"
	set allowed_responses SPACE

define keyboard_response probe_response
	set timeout infinite
	set flush yes
	set duration keypress
	set description "Collects keyboard responses"
	set allowed_responses "y;n"

