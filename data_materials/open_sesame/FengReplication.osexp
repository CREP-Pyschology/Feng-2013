define loop Passage_3_Booklet_1
	set source_file ""
	set source table
	set repeat 1
	set order sequential
	set description "Repeatedly runs another item"
	set cycles 10
	set continuous no
	set break_if_on_first yes
	set break_if never
	setcycle 0 passage 3
	setcycle 0 line 0
	setcycle 0 line_text "Passage 3"
	setcycle 0 probe n
	setcycle 0 condition "Diff."
	setcycle 0 Condition_Num 1
	setcycle 0 comprehension_q n
	setcycle 0 booklet 1
	setcycle 1 passage 3
	setcycle 1 line 1
	setcycle 1 line_text "Atomic energy is the energy that holds the nucleus of an atom <br/>together."
	setcycle 1 probe n
	setcycle 1 condition "Diff."
	setcycle 1 Condition_Num 1
	setcycle 1 comprehension_q n
	setcycle 1 booklet 1
	setcycle 2 passage 3
	setcycle 2 line 2
	setcycle 2 line_text "Atomic reactions in which nuclei of helium are built up from nuclei <br/>of hydrogen are believed to be the origin of the sun’s energy."
	setcycle 2 probe n
	setcycle 2 condition "Diff."
	setcycle 2 Condition_Num 1
	setcycle 2 comprehension_q n
	setcycle 2 booklet 1
	setcycle 3 passage 3
	setcycle 3 line 3
	setcycle 3 line_text "It has been found that the mass of an atomic nucleus is less than the <br/>total mass of the separate particles that comprise it."
	setcycle 3 probe n
	setcycle 3 condition "Diff."
	setcycle 3 Condition_Num 1
	setcycle 3 comprehension_q n
	setcycle 3 booklet 1
	setcycle 4 passage 3
	setcycle 4 line 4
	setcycle 4 line_text "The reason is that when a nucleus forms, part of the mass of the <br/>component particles is changed into energy, which is then radiated away. "
	setcycle 4 probe n
	setcycle 4 condition "Diff."
	setcycle 4 Condition_Num 1
	setcycle 4 comprehension_q n
	setcycle 4 booklet 1
	setcycle 5 passage 3
	setcycle 5 line 5
	setcycle 5 line_text "The quantity of energy released in reactions of this kind is almost <br/>inconceivably greater than the quantity released by any other type of <br/>reaction involving similar quantities of material. "
	setcycle 5 probe y
	setcycle 5 condition "Diff."
	setcycle 5 Condition_Num 1
	setcycle 5 comprehension_q n
	setcycle 5 booklet 1
	setcycle 6 passage 3
	setcycle 6 line 6
	setcycle 6 line_text "Every second, a million times as much energy as is stored in all our <br/>coal, petroleum, and natural gas fields is sent into space by the <br/>sun. "
	setcycle 6 probe n
	setcycle 6 condition "Diff."
	setcycle 6 Condition_Num 1
	setcycle 6 comprehension_q n
	setcycle 6 booklet 1
	setcycle 7 passage 3
	setcycle 7 line 7
	setcycle 7 line_text "If one could duplicate the method by which this energy is released, <br/>the world could be revolutionized. "
	setcycle 7 probe n
	setcycle 7 condition "Diff."
	setcycle 7 Condition_Num 1
	setcycle 7 comprehension_q n
	setcycle 7 booklet 1
	setcycle 8 passage 3
	setcycle 8 line 8
	setcycle 8 line_text "And the possibility of doing just this is no more inconceivable today <br/>than the concept of an atomic bomb was in 1900. "
	setcycle 8 probe n
	setcycle 8 condition "Diff."
	setcycle 8 Condition_Num 1
	setcycle 8 comprehension_q n
	setcycle 8 booklet 1
	setcycle 9 passage 3
	setcycle 9 line 9
	setcycle 9 line_text "The time may come when the hydrogen from a cubic mile of sea water <br/>will provide enough energy to satisfy our needs at the 1960 rate for <br/>300 centuries."
	setcycle 9 probe y
	setcycle 9 condition "Diff."
	setcycle 9 Condition_Num 1
	setcycle 9 comprehension_q n
	setcycle 9 booklet 1
	run Passage_sequence

define loop Passage_3_Booklet_2
	set source_file ""
	set source table
	set repeat 1
	set order sequential
	set description "Repeatedly runs another item"
	set cycles 12
	set continuous no
	set break_if_on_first yes
	set break_if never
	setcycle 0 passage 3
	setcycle 0 line 0
	setcycle 0 line_text "Passage 3"
	setcycle 0 probe n
	setcycle 0 condition Easy
	setcycle 0 Condition_Num 2
	setcycle 0 comprehension_q n
	setcycle 0 booklet 2
	setcycle 1 passage 3
	setcycle 1 line 1
	setcycle 1 line_text "The nucleus of an atom is held together by a kind of energy called <br/>atomic energy."
	setcycle 1 probe n
	setcycle 1 condition Easy
	setcycle 1 Condition_Num 2
	setcycle 1 comprehension_q n
	setcycle 1 booklet 2
	setcycle 2 passage 3
	setcycle 2 line 2
	setcycle 2 line_text "The sun's energy comes from atomic reactions."
	setcycle 2 probe n
	setcycle 2 condition Easy
	setcycle 2 Condition_Num 2
	setcycle 2 comprehension_q n
	setcycle 2 booklet 2
	setcycle 3 passage 3
	setcycle 3 line 3
	setcycle 3 line_text "These reactions occur when the nuclei of hydrogen build up the nuclei <br/>of helium."
	setcycle 3 probe n
	setcycle 3 condition Easy
	setcycle 3 Condition_Num 2
	setcycle 3 comprehension_q n
	setcycle 3 booklet 2
	setcycle 4 passage 3
	setcycle 4 line 4
	setcycle 4 line_text "An atomic nucleus is made of particles, but the mass of the atomic <br/>nucleus is less than the total mass of the particles."
	setcycle 4 probe n
	setcycle 4 condition Easy
	setcycle 4 Condition_Num 2
	setcycle 4 comprehension_q n
	setcycle 4 booklet 2
	setcycle 5 passage 3
	setcycle 5 line 5
	setcycle 5 line_text "The reason for this is that part of the mass of particles is changed <br/>into energy when a nucleus is formed."
	setcycle 5 probe n
	setcycle 5 condition Easy
	setcycle 5 Condition_Num 2
	setcycle 5 comprehension_q n
	setcycle 5 booklet 2
	setcycle 6 passage 3
	setcycle 6 line 6
	setcycle 6 line_text "This energy then radiates away."
	setcycle 6 probe n
	setcycle 6 condition Easy
	setcycle 6 Condition_Num 2
	setcycle 6 comprehension_q n
	setcycle 6 booklet 2
	setcycle 7 passage 3
	setcycle 7 line 7
	setcycle 7 line_text "The quantity of energy released in reactions of this kind is almost <br/>inconceivably greater than the quantity released by any other type of <br/>reaction involving similar quantities of material."
	setcycle 7 probe y
	setcycle 7 condition Easy
	setcycle 7 Condition_Num 2
	setcycle 7 comprehension_q n
	setcycle 7 booklet 2
	setcycle 8 passage 3
	setcycle 8 line 8
	setcycle 8 line_text "Every second, the sun sends a million times more energy into space <br/>than we have stored in all of our coal, petroleum, and natural gas <br/>fields."
	setcycle 8 probe n
	setcycle 8 condition Easy
	setcycle 8 Condition_Num 2
	setcycle 8 comprehension_q n
	setcycle 8 booklet 2
	setcycle 9 passage 3
	setcycle 9 line 9
	setcycle 9 line_text "We could revolutionize the world if we could duplicate the method <br/>that releases such energy."
	setcycle 9 probe n
	setcycle 9 condition Easy
	setcycle 9 Condition_Num 2
	setcycle 9 comprehension_q n
	setcycle 9 booklet 2
	setcycle 10 passage 3
	setcycle 10 line 10
	setcycle 10 line_text "This possibility is not a fantasy, just as it was not a fantasy to <br/>imagine developing an atom bomb in 1900."
	setcycle 10 probe n
	setcycle 10 condition Easy
	setcycle 10 Condition_Num 2
	setcycle 10 comprehension_q n
	setcycle 10 booklet 2
	setcycle 11 passage 3
	setcycle 11 line 11
	setcycle 11 line_text "The time may come when the hydrogen from a cubic mile of sea water <br/>will provide enough energy to satisfy our needs at the 1960 rate for <br/>300 centuries."
	setcycle 11 probe y
	setcycle 11 condition Easy
	setcycle 11 Condition_Num 2
	setcycle 11 comprehension_q n
	setcycle 11 booklet 2
	run Passage_sequence

define loop Passage_3_Comprehension
	set source_file ""
