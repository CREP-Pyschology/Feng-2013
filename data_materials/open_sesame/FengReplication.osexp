	setcycle 2 line_text "3.     The primary focus is on<br/><br/>a.     how energy is released<br/>b.     where energy is found<br/>c.     the energy from atomic reactions<br/>d.     what happens in an atomic reaction<br/>e.     the energy present in sunshine"
	setcycle 2 probe n
	setcycle 2 condition ""
	setcycle 2 Condition_Num ""
	setcycle 2 comprehension_q y
	setcycle 2 booklet ""
	setcycle 2 correct_response c
	setcycle 3 passage 3
