---
API: 2
OpenSesame: 3.1.6
Platform: nt
---
set width 1024
set uniform_coordinates yes
set title "Feng Replication"
set subject_parity even
set subject_nr 0
set start experiment
set sound_sample_size -16
set sound_freq 48000
set sound_channels 2
set sound_buf_size 1024
set sampler_backend legacy
set round_decimals 2
set osf_id 5942b73bb83f690229b9b281
set mouse_backend xpyriment
set keyboard_backend legacy
set height 768
set fullscreen no
set form_clicks no
set foreground black
set font_underline no
set font_size 18
set font_italic no
set font_family mono
set font_bold no
set experiment_path "C:/Users/Brady Wiggins"
set disable_garbage_collection yes
set description "The main experiment item"
set coordinates uniform
set compensation 0
set color_backend legacy
set clock_backend legacy
set canvas_backend xpyriment
set bidi no
set background white

define loop Booklet_Assignment
	set source_file ""
	set source table
	set repeat 0.5
	set order random
	set description "Repeatedly runs another item"
	set cycles 2
	set continuous no
	set break_if_on_first yes
	set break_if never
	setcycle 0 booklet_assign 1
	setcycle 1 booklet_assign 2
	run Instructions_1

define sketchpad Comprehension
	set duration 0
	set description "Displays stimuli"
	draw textline center=0 color=black font_bold=no font_family=mono font_italic=no font_size=22 html=yes show_if=always text="[line_text]" x=-450 y=-200 z_index=0
	draw textline center=0 color=black font_bold=no font_family=mono font_italic=no font_size=22 html=yes show_if="[line] = 1" text="Passage [passage]" x=-450 y=-264 z_index=0

define sequence End_of_Experiment
	set flush_keyboard yes
	set description "Runs a number of items in sequence"
	run End_of_Experiment_Inst always

define loop End_of_Experiment_Inst
	set source_file ""
	set source table
	set repeat 1
	set order sequential
	set description "Repeatedly runs another item"
	set cycles 1
	set continuous no
	set break_if_on_first yes
	set break_if never
	setcycle 0 instruct_num 15
	setcycle 0 instruct_text "End of Experiment<br/><br/>The purpose of this experiment is to assess the effect <br/>of mind-wandering on reading difficulty. Some of the passages <br/>are difficult to comprehend and some are easy to comprehend. <br/>The hypothesis for this experiment is that you will mind-wander <br/>more while reading the hard passages relative to the easy passages. <br/>Your performance on the reading comprehension test will also go down <br/>as you mind-wander. Additionally, you should read relatively slower <br/>during the hard condition than the easy condition. <br/><br/>Thank You for Participating!"
	run Instructions_2_1

define keyboard_response Instr_1_response
	set timeout infinite
	set flush yes
	set duration keypress
	set description "Collects keyboard responses"
	set correct_response SPACE
	set allowed_responses SPACE

define keyboard_response Instr_1_response_1
	set timeout infinite
	set flush yes
	set duration keypress
	set description "Collects keyboard responses"
	set allowed_responses "SPACE;y;n"

define keyboard_response Instr_1_response_1_1
	set timeout infinite
	set flush yes
	set duration keypress
	set description "Collects keyboard responses"
	set allowed_responses "SPACE;y;n"

define sketchpad Instruction1
	set duration 0
	set description "Displays stimuli"
	draw textline center=0 color=black font_bold=no font_family=mono font_italic=no font_size=22 html=yes show_if=always text="[instruct_text]" x=-450 y=-200 z_index=0

define sketchpad Instruction1_1
	set duration 0
	set description "Displays stimuli"
	draw textline center=0 color=black font_bold=no font_family=mono font_italic=no font_size=22 html=yes show_if=always text="[instruct_text]" x=-450 y=-200 z_index=0

define sketchpad Instruction1_1_1
	set duration 0
	set description "Displays stimuli"
	draw textline center=0 color=black font_bold=no font_family=mono font_italic=no font_size=22 html=yes show_if=always text="[instruct_text]" x=-450 y=-200 z_index=0

define sequence Instructions
	set flush_keyboard yes
	set description "Runs a number of items in sequence"
	run Instruction1 always
	run Instr_1_response always

define loop Instructions_1
	set source_file ""
	set source table
	set repeat 1
	set order sequential
	set description "Repeatedly runs another item"
	set cycles 6
	set continuous no
	set break_if_on_first yes
	set break_if never
	setcycle 0 instruct_num 1
	setcycle 0 instruct_text "The goal of this study is to learn how mind wandering affects how you<br/>learn information during reading. Mind wandering is a term used to<br/>describe what occurs when your attention wanders from a task. <br/>Sometimes when your mind wanders, you begin thinking about personal <br/>events or concerns rather than your task. At other times, your mind <br/>can wander because you are bored or tired and you don’t really know <br/>what you’re thinking about; all you know is that you are no longer <br/>thinking about your task. <br/><br/>Please press space bar to continue.<br/>"
	setcycle 1 instruct_num 2
	setcycle 1 instruct_text "In this experiment, you will read 8 passages and answer reading<br/>comprehension questions for each passage. THE PASSAGES WILL BE <br/>PRESENTED IN A SENTENCE-BY-SENTENCE FASHION. PLEASE READ THE <br/>SENTENCES AT YOUR NORMAL READING PACE. ONCE YOU HAVE FINISHED READING <br/>ONE SENTENCE, PRESS THE SPACE KEY TO MOVE ON TO THE NEXT SENTENCE. <br/>Once you've read the sentence you MAY NOT GO BACK.<br/><br/>Please press space bar to continue.<br/>"
	setcycle 2 instruct_num 3
	setcycle 2 instruct_text "THE SET OF READING COMPREHENSION QUESTIONS FOR THAT PARTICULAR <br/>PASSAGE YOU’VE FINISHED READING WILL APPEAR AFTER EACH PASSAGE, not <br/>all together at the end. Like the sentences, once you've answered the <br/>questions you MAY NOT GO BACK TO CHANGE YOUR ANSWER.<br/><br/>Please press space bar to continue."
	setcycle 3 instruct_num 4
	setcycle 3 instruct_text "Additionally, while you are reading you will be randomly interrupted <br/>and asked “WERE YOU MIND WANDERING WHEN YOU READ THE PREVIOUS <br/>SENTENCE?\" as the question will appear on screen. That is, whether <br/>your thoughts were off-task rather than focusing on the prior <br/>sentence, in which you would have to choose either “Yes” or “No” by <br/>pressing the \"Y\" for Yes or \"N\" for No on your keyboard. <br/><br/>Please press space bar to continue.<br/>"
	setcycle 4 instruct_num 5
	setcycle 4 instruct_text "This entire experiment is self-paced. Though of course you should try <br/>NOT TO go over the experiment's ending time. So try to do the task <br/>all the way through instead of taking too many small breaks in between.<br/>The experiment isn't long so you should be able to do it without <br/>taking any breaks. <br/><br/>Please press space bar to continue.<br/>"
	setcycle 5 instruct_num 6
	setcycle 5 instruct_text "Do you have any questions so far?<br /><br/>If not, you may press the spacebar key to read the first passage."
	run Instructions

define sequence Instructions_2
	set flush_keyboard yes
	set description "Runs a number of items in sequence"
	run Instruction1_1 always
	run Instr_1_response_1 always

define sequence Instructions_2_1
	set flush_keyboard yes
	set description "Runs a number of items in sequence"
	run Instruction1_1_1 always
	run Instr_1_response_1_1 always

