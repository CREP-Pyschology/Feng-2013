	setcycle 42 comprehension_q ""
	setcycle 42 booklet ""
	setcycle 43 passage ""
	setcycle 43 line ""
	setcycle 43 line_text "Her Sonnets, in their autobiographical candor, in their fine <br/>restraint and fullness, reveal a woman’s secret soul as had no other <br/>poetry in our literature up to that time. "
	setcycle 43 probe ""
	setcycle 43 condition ""
	setcycle 43 Condition_Num ""
