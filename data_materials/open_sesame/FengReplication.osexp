	run Passage_7_Booklet_2 "[booklet_assign] = 2"
	run P7_Comprehension_Instructions always
	run Passage_7_Comprehension always

define loop Passage_7_Booklet_1
	set source_file ""
	set source table
	set repeat 1
	set order sequential
	set description "Repeatedly runs another item"
	set cycles 11
	set continuous no
	set break_if_on_first yes
	set break_if never
	setcycle 0 passage 7
	setcycle 0 line 0
	setcycle 0 line_text "Passage 7"
	setcycle 0 probe n
	setcycle 0 condition "Diff."
	setcycle 0 Condition_Num 1
	setcycle 0 comprehension_q n
	setcycle 0 booklet 1
	setcycle 1 passage 7
	setcycle 1 line 1
	setcycle 1 line_text "Once in a while you will hear about an artist recognized as a master <br/>during his own lifetime but then almost forgotten soon after his <br/>death. "
	setcycle 1 probe n
	setcycle 1 condition "Diff."
	setcycle 1 Condition_Num 1
	setcycle 1 comprehension_q n
	setcycle 1 booklet 1
	setcycle 2 passage 7
	setcycle 2 line 2
	setcycle 2 line_text "A good example is the painter Domenicos Theotocopoulos, known because <br/>of his Greek ancestry as El Greco."
	setcycle 2 probe n
	setcycle 2 condition "Diff."
	setcycle 2 Condition_Num 1
	setcycle 2 comprehension_q n
	setcycle 2 booklet 1
	setcycle 3 passage 7
	setcycle 3 line 3
	setcycle 3 line_text "After pursuing his early career in Italy, El Greco settled in the <br/>Spanish city of Toledo, where he prospered for the rest of his life."
	setcycle 3 probe y
	setcycle 3 condition "Diff."
	setcycle 3 Condition_Num 1
	setcycle 3 comprehension_q n
	setcycle 3 booklet 1
	setcycle 4 passage 7
	setcycle 4 line 4
	setcycle 4 line_text "But after his death, El Greco was forgotten by history for nearly <br/>three hundred years, until he was rediscovered by artists and critics <br/>of the twentieth century."
	setcycle 4 probe n
	setcycle 4 condition "Diff."
	setcycle 4 Condition_Num 1
	setcycle 4 comprehension_q n
	setcycle 4 booklet 1
	setcycle 5 passage 7
	setcycle 5 line 5
	setcycle 5 line_text "The power of El Greco’s intensely emotional style can be felt most <br/>strongly in his later canvases, such as the famous View of Toledo <br/>painted in 1610, only a few years before death."
	setcycle 5 probe n
	setcycle 5 condition "Diff."
	setcycle 5 Condition_Num 1
	setcycle 5 comprehension_q n
	setcycle 5 booklet 1
	setcycle 6 passage 7
	setcycle 6 line 6
	setcycle 6 line_text "One notices in this strange landscape how the eerie, silvery <br/>buildings take on a ghostlike stillness next to the explosive light <br/>of the sky and the writhing forms of the countryside below."
	setcycle 6 probe n
	setcycle 6 condition "Diff."
	setcycle 6 Condition_Num 1
	setcycle 6 comprehension_q n
	setcycle 6 booklet 1
	setcycle 7 passage 7
	setcycle 7 line 7
	setcycle 7 line_text "Curiously enough, another important artist of about the same time was <br/>scorned even by many of his own contemporaries."
	setcycle 7 probe n
	setcycle 7 condition "Diff."
	setcycle 7 Condition_Num 1
	setcycle 7 comprehension_q n
	setcycle 7 booklet 1
	setcycle 8 passage 7
	setcycle 8 line 8
	setcycle 8 line_text "This artist was Caravaggio, a self-taught painter who had come to <br/>Rome around 1590 from a small town in Lombardy."
	setcycle 8 probe n
	setcycle 8 condition "Diff."
	setcycle 8 Condition_Num 1
	setcycle 8 comprehension_q n
	setcycle 8 booklet 1
	setcycle 9 passage 7
	setcycle 9 line 9
	setcycle 9 line_text "Caravaggio’s critics complained that he treated exalted religious <br/>subjects in a low, vulgar style, because he included in his paintings <br/>the faces and figures from the street of common people."
	setcycle 9 probe n
	setcycle 9 condition "Diff."
	setcycle 9 Condition_Num 1
	setcycle 9 comprehension_q n
	setcycle 9 booklet 1
	setcycle 10 passage 7
	setcycle 10 line 10
	setcycle 10 line_text "By using stark contrasts of light and shadow, Caravaggio managed to <br/>conjure up unforgettable scenes of dramatic realism."
	setcycle 10 probe y
	setcycle 10 condition "Diff."
	setcycle 10 Condition_Num 1
	setcycle 10 comprehension_q n
	setcycle 10 booklet 1
	run Passage_sequence

