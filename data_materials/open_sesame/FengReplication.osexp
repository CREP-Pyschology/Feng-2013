	setcycle 47 Condition_Num ""
	setcycle 47 comprehension_q ""
	setcycle 47 booklet ""
	setcycle 48 passage ""
	setcycle 48 line ""
	setcycle 48 line_text "Hawthorne saw the Browning's there: the New England thinker and <br/>essayist Margaret Fuller visited them."
